{
  "name": "@bosco/desktop",
  "private": true,
  "description": "Application du poste (Linux) : une coquille autour du service et de l'interface de Bosco, avec la barre système et les notifications natives. Facultative : Bosco se lance toujours dans le navigateur.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node scripts/run.mjs",
    "install-launcher": "node scripts/install-launcher.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bosco/domain": "workspace:*"
  },
  "devDependencies": {
    "@bosco/configs": "workspace:*",
    "@types/node": "26.6.6",
    "electron": "45.2.3",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
