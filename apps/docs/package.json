{
  "name": "@bosco/docs",
  "private": true,
  "description": "Site de documentation de Bosco (Fumadocs), exporté en pages statiques dans out/.",
  "type": "module",
  "scripts": {
    "generate": "fumadocs-mdx",
    "docs": "fumadocs-mdx && next dev --port 4890 --hostname 127.0.0.1",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bosco/domain": "workspace:*",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "fumadocs-core": "16.19.3",
    "fumadocs-mdx": "15.6.3",
    "fumadocs-ui": "16.19.3",
    "lucide-react": "1.73.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@bosco/configs": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
