{
  "name": "@bosco/api",
  "private": true,
  "description": "Application serveur de Bosco : le service (API, flux en direct, hooks, interface Next.js sur le même port) et la commande bosco.",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "bosco": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migration": "node src/scripts/create-migration.ts",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@bosco/domain": "workspace:*",
    "@mikro-orm/core": "7.2.8",
    "@mikro-orm/migrations": "7.2.8",
    "@mikro-orm/sqlite": "7.2.8",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-fastify": "12.4.0",
    "chokidar": "6.0.0",
    "commander": "15.1.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bosco/configs": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
