{
  "name": "@bosco/cli",
  "private": true,
  "description": "Commande bosco : démarrer le service, l'installer comme service systemd de l'utilisateur.",
  "type": "module",
  "bin": {
    "bosco": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bosco/api": "workspace:*",
    "@bosco/domain": "workspace:*",
    "commander": "15.1.0"
  },
  "devDependencies": {
    "@bosco/configs": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
