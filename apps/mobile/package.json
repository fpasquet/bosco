{
  "name": "@bosco/mobile",
  "private": true,
  "description": "Application Android (E18, DT-33) : une coquille autour de l'interface téléphone de Bosco, appairée par QR code, qui ne fait confiance qu'au certificat du poste et notifie sans service de push.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "expo": "58.0.23",
    "expo-build-properties": "58.0.12",
    "expo-camera": "58.0.14",
    "expo-notifications": "58.1.8",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@bosco/configs": "workspace:*",
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
