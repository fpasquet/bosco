+    /** Empreinte SHA-256 du certificat (« AA:BB:… ») comparée à celle que l'application Bosco a gardée. */
+    private static boolean isPinnedCertificate(final WebView webView, final SslError error) {
+        try {
+            String pinned = webView.getContext()
+                .getSharedPreferences("bosco", android.content.Context.MODE_PRIVATE)
+                .getString("certificate", null);
+            if (pinned == null || error.getCertificate() == null) return false;
+            byte[] der = android.net.http.SslCertificate.saveState(error.getCertificate()).getByteArray("x509-certificate");
+            if (der == null) return false;
+            byte[] digest = java.security.MessageDigest.getInstance("SHA-256").digest(der);
+            StringBuilder hex = new StringBuilder();
+            for (int i = 0; i < digest.length; i++) {
+                if (i > 0) hex.append(':');
+                hex.append(String.format("%02X", digest[i]));
+            }
+            return hex.toString().equalsIgnoreCase(pinned);
+        } catch (Exception e) {
+            return false;
+        }
+    }
