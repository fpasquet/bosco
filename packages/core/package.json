{
  "name": "@bosco/core",
  "private": true,
  "type": "module",
  "exports": {
    "./sessions": {
      "types": "./dist/sessions/index.d.ts",
      "default": "./dist/sessions/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@bosco/configs": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "description": "Domaine et cas d'usage de Bosco, sans framework : un dossier par contexte (domain, application)."
}
